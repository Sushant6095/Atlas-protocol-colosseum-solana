# ── Sentinel Phase 1 env vars ───────────────────────────────────
# Copy to .env.local. Leaving any blank keeps that integration on
# Phase 0 mock data.

# Quicknode Solana mainnet HTTPS endpoint.
# Sign up: https://www.quicknode.com/chains/sol
# Pattern: https://<name>.solana-mainnet.quiknode.pro/<token>/
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Birdeye API key.
# Sign up: https://bds.birdeye.so/dashboard
NEXT_PUBLIC_BIRDEYE_KEY=

# Kamino live-mode flag. Set to "1" when the SDK call path is wired
# and tested. Leave blank to keep using fixture positions.
NEXT_PUBLIC_KAMINO_LIVE=

# DFlow comes in Phase 2 — leave blank.
# NEXT_PUBLIC_DFLOW_KEY=
