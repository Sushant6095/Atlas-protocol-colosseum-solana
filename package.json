{
  "name": "atlas-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "web",
    "docs",
    "apps/*",
    "packages/*",
    "sdk/ts",
    "tests"
  ],
  "scripts": {
    "build": "turbo build",
    "build:legacy": "pnpm -r build",
    "dev": "pnpm --filter @atlas/web dev",
    "dev:web": "pnpm --filter @atlas/web-marketing dev",
    "dev:app": "pnpm --filter @atlas/web-app dev",
    "dev:dev": "pnpm --filter @atlas/web-dev dev",
    "dev:docs": "pnpm --filter @atlas/docs dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "codama:gen": "node scripts/codama-gen.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "turbo": "^2.1.0"
  }
}
